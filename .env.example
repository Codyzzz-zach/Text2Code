# T2C LLM Configuration
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# T2C will read .env automatically (best-effort, no python-dotenv needed).
# The same keys can also live in your shell environment.
#
# All keys are optional except T2C_LLM_API_KEY when --llm is used without
# read_only cache. If unset, non-LLM compilation still works.

# --- Provider selection ---
# One of: deepseek (default), minimax, anthropic, openai, custom:<name>
T2C_LLM_PROVIDER=deepseek

# --- Endpoint ---
# Overrides the provider's default base URL. Leave blank to use the preset.
T2C_LLM_BASE_URL=https://api.deepseek.com/anthropic

# --- Model ---
# Overrides the provider's default model.
T2C_LLM_MODEL=deepseek-v4-flash

# --- Auth ---
# T2C will also fall back to ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY /
# OPENAI_API_KEY / DEEPSEEK_API_KEY depending on the provider if
# T2C_LLM_API_KEY is empty.
T2C_LLM_API_KEY=

# --- Generation parameters ---
T2C_LLM_MAX_TOKENS=8192
T2C_LLM_THINKING_BUDGET=0

# --- Cache ---
# off | read_write | read_only | refresh
T2C_LLM_CACHE_MODE=read_write
T2C_LLM_CACHE_DIR=.t2c_cache

# --- Protocol / prompt version ---
# compact-v1 (default) | verbose-v1
T2C_LLM_PROTOCOL=compact-v1
T2C_LLM_PROMPT_VERSION=compact-main-v2
